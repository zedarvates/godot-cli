{
  "name": "@ultimate-odycer/godot-runtime-cli",
  "version": "0.1.0-uo.4",
  "description": "Hardened, local-only runtime CLI for Ultimate Odycer Godot development",
  "type": "module",
  "bin": {
    "uo-godot-cli": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "godot-addon/addons/godot_cli/",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:godot": "npm run build && node --test test/godot-smoke.test.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
